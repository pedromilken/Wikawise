s": "祝你生日___！", "o": ["快乐", "高兴", "好吃", "漂亮"], "ans": "快乐", "ex": "生日快乐 = feliz aniversário.", "full": "祝你生日快乐！", "py": "zhù nǐ shēng rì kuài lè!"}, {"a": 7, "s": "2022年7月11___", "o": ["日", "天", "星期", "年"], "ans": "日", "ex": "Data: ano → mês → 日/号.", "full": "2022年7月11日", "py": "2022 nián 7 yuè 11 rì"}, {"a": 8, "s": "___明天是节日，所以我们不上课。", "o": ["因为", "为什么", "所以", "什么时候"], "ans": "因为", "ex": "因为 + motivo，所以 + consequência.", "full": "因为明天是节日，所以我们不上课。", "py": "yīn wèi míng tiān shì jié rì, suǒ yǐ wǒ men bù shàng kè."}, {"a": 8, "s": "你___有空？(quando)", "o": ["什么时候", "为什么", "怎么", "几"], "ans": "什么时候", "ex": "Pergunta \"quando?\" → 什么时候.", "full": "你什么时候有空？", "py": "nǐ shén me shí hòu yǒu kòng?"}, {"a": 8, "s": "我___年回巴西。(ano passado)", "o": ["去", "上个", "明", "今"], "ans": "去", "ex": "Ano passado = 去年 (sem 个).", "full": "我去年回巴西。", "py": "wǒ qù nián huí bā xī."}, {"a": 8, "s": "___个星期我们没有课。(próxima)", "o": ["下", "上", "去", "明"], "ans": "下", "ex": "Próxima semana = 下个星期.", "full": "下个星期我们没有课。", "py": "xià ge xīng qī wǒ men méi yǒu kè."}, {"a": 8, "s": "今天我没有___。(tempo livre)", "o": ["空", "忙", "时候", "节日"], "ans": "空", "ex": "有空 / 没有空 = ter / não ter tempo.", "full": "今天我没有空。", "py": "jīn tiān wǒ méi yǒu kōng."}, {"a": 9, "s": "我买___一个手机。", "o": ["了", "过", "着", "的"], "ans": "了", "ex": "Verbo + 了 = ação concluída.", "full": "我买了一个手机。", "py": "wǒ mǎi le yī ge shǒu jī."}, {"a": 9, "s": "我昨天___去学校。", "o": ["没", "不", "了", "别"], "ans": "没", "ex": "Negar o passado → 没, sem 了.", "full": "我昨天没去学校。", "py": "wǒ zuó tiān méi qù xué xiào."}, {"a": 9, "s": "这个果汁我不喝___。(não mais)", "o": ["了", "过", "的", "吗"], "ans": "了", "ex": "不…了 = não… mais.", "full": "这个果汁我不喝了。", "py": "zhè ge guǒ zhī wǒ bù hē le."}, {"a": 9, "s": "明天你___买什么？", "o": ["会", "了", "过", "在"], "ans": "会", "ex": "Futuro → 会 + verbo.", "full": "明天你会买什么？", "py": "míng tiān nǐ huì mǎi shén me?"}, {"a": 9, "s": "她上个星期___学汉语。", "o": ["开始", "开", "到", "会"], "ans": "开始", "ex": "开始 + verbo = começar a.", "full": "她上个星期开始学汉语。", "py": "tā shàng ge xīng qī kāi shǐ xué hàn yǔ."}, {"a": 9, "s": "请你不___走！", "o": ["要", "会", "能", "是"], "ans": "要", "ex": "不要 + verbo = imperativo negativo.", "full": "请你不要走！", "py": "qǐng nǐ bù yào zǒu!"}, {"a": 10, "s": "我没看___你。", "o": ["见", "看", "了", "着"], "ans": "见", "ex": "看见 = ver (resultado).", "full": "我没看见你。", "py": "wǒ méi kàn jiàn nǐ."}, {"a": 10, "s": "猫在箱子___。(dentro)", "o": ["里", "上", "下", "前"], "ans": "里", "ex": "Dentro → 里.", "full": "猫在箱子里。", "py": "māo zài xiāng zi lǐ."}, {"a": 10, "s": "你到___时候给我打电话。", "o": ["的", "了", "是", "在"], "ans": "的", "ex": "Frase + 的时候 = quando.", "full": "你到的时候给我打电话。", "py": "nǐ dào de shí hòu gěi wǒ dǎ diàn huà."}, {"a": 10, "s": "请___我打电话。", "o": ["给", "和", "在", "对"], "ans": "给", "ex": "给 + pessoa + 打电话.", "full": "请给我打电话。", "py": "qǐng gěi wǒ dǎ diàn huà."}, {"a": 10, "s": "桌子上___一本书。", "o": ["有", "在", "是", "了"], "ans": "有", "ex": "Lugar + 有 + coisa = existe.", "full": "桌子上有一本书。", "py": "zhuō zi shàng yǒu yī běn shū."}, {"a": 11, "s": "我家___公司很近。", "o": ["离", "在", "到", "从"], "ans": "离", "ex": "Lugar1 + 离 + Lugar2 + distância.", "full": "我家离公司很近。", "py": "wǒ jiā lí gōng sī hěn jìn."}, {"a": 11, "s": "今天天气怎么___？", "o": ["样", "么", "好", "了"], "ans": "样", "ex": "天气怎么样？", "full": "今天天气怎么样？", "py": "jīn tiān tiān qì zěn me yàng?"}, {"a": 11, "s": "明天会下___吗？(chuva)", "o": ["雨", "雪", "天", "气"], "ans": "雨", "ex": "下雨 = chover.", "full": "明天会下雨吗？", "py": "míng tiān huì xià yǔ ma?"}, {"a": 11, "s": "下雨___！(começou agora)", "o": ["了", "过", "的", "着"], "ans": "了", "ex": "了 final = situação nova.", "full": "下雨了！", "py": "xià yǔ le!"}, {"a": 11, "s": "我的家很___。(longe)", "o": ["远", "近", "冷", "热"], "ans": "远", "ex": "远 = longe; 近 = perto.", "full": "我的家很远。", "py": "wǒ de jiā hěn yuǎn."}, {"a": 12, "s": "___，是哪位？", "o": ["喂", "请", "好", "对"], "ans": "喂", "ex": "Atender o telefone → 喂.", "full": "喂，是哪位？", "py": "wéi, shì nǎ wèi?"}, {"a": 12, "s": "我想___你看电影。(convidar)", "o": ["请", "帮", "给", "让"], "ans": "请", "ex": "S1 + 请 + S2 + ação = convidar.", "full": "我想请你看电影。", "py": "wǒ xiǎng qǐng nǐ kàn diàn yǐng."}, {"a": 12, "s": "你是怎么去___？", "o": ["的", "了", "过", "吗"], "ans": "的", "ex": "Detalhe do passado → 是…的.", "full": "你是怎么去的？", "py": "nǐ shì zěn me qù de?"}, {"a": 12, "s": "两百___二 (202)", "o": ["零", "十", "一", "百"], "ans": "零", "ex": "Zero no meio do número → 零.", "full": "两百零二", "py": "liǎng bǎi líng èr"}, {"a": 12, "s": "你可以___我吗？", "o": ["帮", "请", "给", "对"], "ans": "帮", "ex": "帮 + pessoa = ajudar.", "full": "你可以帮我吗？", "py": "nǐ kě yǐ bāng wǒ ma?"}, {"a": 12, "s": "她们不___昨天来的。", "o": ["是", "在", "有", "了"], "ans": "是", "ex": "Negativa: 不是…的 (是 obrigatório).", "full": "她们不是昨天来的。", "py": "tā men bù shì zuó tiān lái de."}, {"a": 13, "s": "我去___中国。(já fui alguma vez)", "o": ["过", "了", "着", "的"], "ans": "过", "ex": "Experiência → verbo + 过.", "full": "我去过中国。", "py": "wǒ qù guo zhōng guó."}, {"a": 13, "s": "我___你高。", "o": ["比", "跟", "对", "和"], "ans": "比", "ex": "A + 比 + B + adjetivo.", "full": "我比你高。", "py": "wǒ bǐ nǐ gāo."}, {"a": 13, "s": "他跑___很快。", "o": ["得", "的", "了", "着"], "ans": "得", "ex": "Verbo + 得 + adjetivo = modo da ação.", "full": "他跑得很快。", "py": "tā pǎo de hěn kuài."}, {"a": 13, "s": "门开___。", "o": ["着", "过", "了", "得"], "ans": "着", "ex": "Estado que continua → 着.", "full": "门开着。", "py": "mén kāi zhe."}, {"a": 13, "s": "你喝茶___咖啡？", "o": ["还是", "和", "也", "都"], "ans": "还是", "ex": "\"Ou\" em pergunta → 还是.", "full": "你喝茶还是咖啡？", "py": "nǐ hē chá hái shì kā fēi?"}, {"a": 13, "s": "这个___便宜。(o mais)", "o": ["最", "很", "太", "比"], "ans": "最", "ex": "Superlativo → 最.", "full": "这个最便宜。", "py": "zhè ge zuì pián yi."}, {"a": 13, "s": "我___吃饭了。(já)", "o": ["已经", "还是", "正在", "快要"], "ans": "已经", "ex": "已经…了 = já.", "full": "我已经吃饭了。", "py": "wǒ yǐ jīng chī fàn le."}, {"a": 13, "s": "我去过两___。", "o": ["次", "个", "本", "件"], "ans": "次", "ex": "Número de vezes → 次.", "full": "我去过两次。", "py": "wǒ qù guo liǎng cì."}], "sent": [{"a": 1, "zh": "我住在巴西。", "pt": "Eu moro no Brasil.", "toks": ["我", "住", "在", "巴西"], "end": "。", "py": "wǒ zhù zài bā xī.", "alt": null}, {"a": 1, "zh": "我不知道你说什么。", "pt": "Não sei o que você diz.", "toks": ["我", "不", "知道", "你", "说", "什么"], "end": "。", "py": "wǒ bù zhī dào nǐ shuō shén me.", "alt": null}, {"a": 2, "zh": "我想和你一起吃饭。", "pt": "Quero comer junto com você.", "toks": ["我", "想", "和", "你", "一起", "吃饭"], "end": "。", "py": "wǒ xiǎng hé nǐ yī qǐ chī fàn.", "alt": null}, {"a": 2, "zh": "我在那个公司工作。", "pt": "Trabalho naquela empresa.", "toks": ["我", "在", "那个", "公司", "工作"], "end": "。", "py": "wǒ zài nà ge gōng sī gōng zuò.", "alt": null}, {"a": 3, "zh": "我每天坐地铁去公司。", "pt": "Todo dia vou de metrô para a empresa.", "toks": ["我", "每天", "坐", "地铁", "去", "公司"], "end": "。", "py": "wǒ měi tiān zuò dì tiě qù gōng sī.", "alt": null}, {"a": 3, "zh": "你怎么去学校？", "pt": "Como você vai para a escola?", "toks": ["你", "怎么", "去", "学校"], "end": "？", "py": "nǐ zěn me qù xué xiào?", "alt": null}, {"a": 4, "zh": "我想去商店买东西。", "pt": "Quero ir à loja comprar coisas.", "toks": ["我", "想", "去", "商店", "买", "东西"], "end": "。", "py": "wǒ xiǎng qù shāng diàn mǎi dōng xi.", "alt": null}, {"a": 4, "zh": "我们在饭店见。", "pt": "Nos vemos no restaurante.", "toks": ["我们", "在", "饭店", "见"], "end": "。", "py": "wǒ men zài fàn diàn jiàn.", "alt": null}, {"a": 5, "zh": "我想喝一点水。", "pt": "Quero beber um pouco de água.", "toks": ["我", "想", "喝", "一点", "水"], "end": "。", "py": "wǒ xiǎng hē yī diǎn shuǐ.", "alt": null}, {"a": 5, "zh": "这个衣服太贵了。", "pt": "Esta roupa é cara demais.", "toks": ["这个", "衣服", "太", "贵", "了"], "end": "。", "py": "zhè ge yī fu tài guì le.", "alt": null}, {"a": 6, "zh": "我早上八点上班。", "pt": "Começo a trabalhar às 8 da manhã.", "toks": ["我", "早上", "八点", "上班"], "end": "。", "py": "wǒ zǎo shang bā diǎn shàng bān.", "alt": null}, {"a": 6, "zh": "现在两点半。", "pt": "Agora são duas e meia.", "toks": ["现在", "两点", "半"], "end": "。", "py": "xiàn zài liǎng diǎn bàn.", "alt": null}, {"a": 7, "zh": "我的生日是六月十二号。", "pt": "Meu aniversário é 12 de junho.", "toks": ["我", "的", "生日", "是", "六月", "十二号"], "end": "。", "py": "wǒ de shēng rì shì liù yuè shí èr hào.", "alt": null}, {"a": 7, "zh": "明天我去饭店吃饭。", "pt": "Amanhã vou comer no restaurante.", "toks": ["明天", "我", "去", "饭店", "吃饭"], "end": "。", "py": "míng tiān wǒ qù fàn diàn chī fàn.", "alt": "我明天去饭店吃饭"}, {"a": 8, "zh": "你什么时候有空？", "pt": "Quando você tem tempo livre?", "toks": ["你", "什么", "时候", "有空"], "end": "？", "py": "nǐ shén me shí hòu yǒu kòng?", "alt": null}, {"a": 8, "zh": "下个星期我们没有课。", "pt": "Semana que vem não temos aula.", "toks": ["下个", "星期", "我们", "没有", "课"], "end": "。", "py": "xià ge xīng qī wǒ men méi yǒu kè.", "alt": "我们下个星期没有课"}, {"a": 9, "zh": "我昨天没去学校。", "pt": "Ontem não fui à escola.", "toks": ["我", "昨天", "没", "去", "学校"], "end": "。", "py": "wǒ zuó tiān méi qù xué xiào.", "alt": null}, {"a": 9, "zh": "我学习汉语一年了。", "pt": "Estudo chinês há um ano.", "toks": ["我", "学习", "汉语", "一年", "了"], "end": "。", "py": "wǒ xué xí hàn yǔ yī nián le.", "alt": null}, {"a": 10, "zh": "我的书在桌子上面。", "pt": "Meu livro está em cima da mesa.", "toks": ["我", "的", "书", "在", "桌子", "上面"], "end": "。", "py": "wǒ de shū zài zhuō zi shàng mian.", "alt": null}, {"a": 10, "zh": "请给我打电话。", "pt": "Por favor, me ligue.", "toks": ["请", "给", "我", "打电话"], "end": "。", "py": "qǐng gěi wǒ dǎ diàn huà.", "alt": null}, {"a": 11, "zh": "我家离公司不太远。", "pt": "Minha casa não é muito longe da empresa.", "toks": ["我家", "离", "公司", "不太", "远"], "end": "。", "py": "wǒ jiā lí gōng sī bù tài yuǎn.", "alt": null}, {"a": 11, "zh": "今天天气很冷。", "pt": "Hoje está muito frio.", "toks": ["今天", "天气", "很", "冷"], "end": "。", "py": "jīn tiān tiān qì hěn lěng.", "alt": null}, {"a": 12, "zh": "我想请你看电影。", "pt": "Quero te convidar para ver um filme.", "toks": ["我", "想", "请", "你", "看", "电影"], "end": "。", "py": "wǒ xiǎng qǐng nǐ kàn diàn yǐng.", "alt": null}, {"a": 12, "zh": "你是什么时候到北京的？", "pt": "Quando foi que você chegou a Pequim?", "toks": ["你", "是", "什么", "时候", "到", "北京", "的"], "end": "？", "py": "nǐ shì shén me shí hòu dào běi jīng de?", "alt": null}, {"a": 13, "zh": "我去过中国。", "pt": "Já fui à China.", "toks": ["我", "去", "过", "中国"], "end": "。", "py": "wǒ qù guo zhōng guó.", "alt": null}, {"a": 13, "zh": "我比你高。", "pt": "Sou mais alto que você.", "toks": ["我", "比", "你", "高"], "end": "。", "py": "wǒ bǐ nǐ gāo.", "alt": null}], "read": [{"a": 1, "t": "Onde você mora?", "lines": [{"sp": "A", "zh": "李朋友，你好，你住在哪儿？", "py": "lǐ péng you, nǐ hǎo, nǐ zhù zài nǎr?"}, {"sp": "B", "zh": "你好卡米，我和家人都住在西安，你呢？", "py": "nǐ hǎo kǎ mǐ, wǒ hé jiā rén dōu zhù zài xī ān, nǐ ne?"}, {"sp": "A", "zh": "我和姐姐住在北京，我爷爷奶奶住在上海。", "py": "wǒ hé jiě jie zhù zài běi jīng, wǒ yé ye nǎi nai zhù zài shàng hǎi."}, {"sp": "B", "zh": "北京好玩吗？我知道北京太漂亮了！", "py": "běi jīng hǎo wán ma? wǒ zhī dào běi jīng tài piào liang le!"}, {"sp": "A", "zh": "北京很好玩儿，西安呢？", "py": "běi jīng hěn hǎo wánr, xī ān ne?"}, {"sp": "B", "zh": "西安也很好玩，这里有兵马俑，你知道吗？", "py": "xī ān yě hěn hǎo wán, zhè lǐ yǒu bīng mǎ yǒng, nǐ zhī dào ma?"}, {"sp": "A", "zh": "知道！你们有好吃的菜吗？", "py": "zhī dào! nǐ men yǒu hǎo chī de cài ma?"}, {"sp": "B", "zh": "有啊，西安有很多菜！", "py": "yǒu a, xī ān yǒu hěn duō cài!"}], "q": [{"q": "Onde mora o amigo Li (B)?", "o": ["西安", "北京", "上海", "巴西"], "ans": "西安", "py": {"西安": "xī ān", "北京": "běi jīng", "上海": "shàng hǎi", "巴西": "bā xī"}}, {"q": "Com quem Kami (A) mora?", "o": ["姐姐", "爷爷奶奶", "家人", "朋友"], "ans": "姐姐", "py": {"姐姐": "jiě jie", "爷爷奶奶": "yé ye nǎi nai", "家人": "jiā rén", "朋友": "péng you"}}, {"q": "O que tem em Xi'an?", "o": ["兵马俑", "长城", "故宫", "外滩"], "ans": "兵马俑", "py": {"兵马俑": "bīng mǎ yǒng", "长城": "cháng chéng", "故宫": "gù gōng", "外滩": "wài tān"}}]}, {"a": 2, "t": "Posso ir comer com você?", "lines": [{"sp": "A", "zh": "你好林同学，你在哪里？", "py": "nǐ hǎo lín tóng xué, nǐ zài nǎ lǐ?"}, {"sp": "B", "zh": "我在学校，你呢？", "py": "wǒ zài xué xiào, nǐ ne?"}, {"sp": "A", "zh": "我也在学校，你想和我一起吃饭吗？", "py": "wǒ yě zài xué xiào, nǐ xiǎng hé wǒ yī qǐ chī fàn ma?"}, {"sp": "B", "zh": "可以！你想去哪个饭店？", "py": "kě yǐ! nǐ xiǎng qù nǎ ge fàn diàn?"}, {"sp": "A", "zh": "我想去那个中国饭店，我很想吃一些牛肉饺子。", "py": "wǒ xiǎng qù nà ge zhōng guó fàn diàn, wǒ hěn xiǎng chī yī xiē niú ròu jiǎo zi."}, {"sp": "B", "zh": "好的！我也去，那个饭店很好。", "py": "hǎo de! wǒ yě qù, nà ge fàn diàn hěn hǎo."}, {"sp": "A", "zh": "我的泰国朋友也想去，我们可以在饭店见！", "py": "wǒ de tài guó péng you yě xiǎng qù, wǒ men kě yǐ zài fàn diàn jiàn!"}, {"sp": "B", "zh": "好的，我们一会儿见！", "py": "hǎo de, wǒ men yī huìr jiàn!"}], "q": [{"q": "Onde está o colega Lin?", "o": ["学校", "饭店", "家", "公司"], "ans": "学校", "py": {"学校": "xué xiào", "饭店": "fàn diàn", "家": "jiā", "公司": "gōng sī"}}, {"q": "O que eles querem fazer?", "o": ["一起吃饭", "一起学习", "去银行", "回家"], "ans": "一起吃饭", "py": {"一起吃饭": "yī qǐ chī fàn", "一起学习": "yī qǐ xué xí", "去银行": "qù yín háng", "回家": "huí jiā"}}, {"q": "O que A quer comer?", "o": ["牛肉饺子", "米饭", "面条", "蛋糕"], "ans": "牛肉饺子", "py": {"牛肉饺子": "niú ròu jiǎo zi", "米饭": "mǐ fàn", "面条": "miàn tiáo", "蛋糕": "dàn gāo"}}]}, {"a": 3, "t": "Como você vai à escola?", "lines": [{"sp": "A", "zh": "朋友，你好，你怎么样？", "py": "péng you, nǐ hǎo, nǐ zěn me yàng?"}, {"sp": "B", "zh": "我很好，你呢？", "py": "wǒ hěn hǎo, nǐ ne?"}, {"sp": "A", "zh": "我也很好，你在哪儿？", "py": "wǒ yě hěn hǎo, nǐ zài nǎr?"}, {"sp": "B", "zh": "我在学校，你也在吗？", "py": "wǒ zài xué xiào, nǐ yě zài ma?"}, {"sp": "A", "zh": "我不在学校，你怎么去学校？", "py": "wǒ bù zài xué xiào, nǐ zěn me qù xué xiào?"}, {"sp": "B", "zh": "我坐地铁去，你呢？", "py": "wǒ zuò dì tiě qù, nǐ ne?"}, {"sp": "A", "zh": "我骑自行车去，你中午想和我一起吃饭吗？", "py": "wǒ qí zì xíng chē qù, nǐ zhōng wǔ xiǎng hé wǒ yī qǐ chī fàn ma?"}, {"sp": "B", "zh": "可以，你想去哪儿吃饭？", "py": "kě yǐ, nǐ xiǎng qù nǎr chī fàn?"}, {"sp": "A", "zh": "我想要去那个巴西饭店，好不好？", "py": "wǒ xiǎng yào qù nà ge bā xī fàn diàn, hǎo bù hǎo?"}, {"sp": "B", "zh": "好的，我们怎么去？", "py": "hǎo de, wǒ men zěn me qù?"}, {"sp": "A", "zh": "我们可以坐地铁去，在地铁站见。", "py": "wǒ men kě yǐ zuò dì tiě qù, zài dì tiě zhàn jiàn."}, {"sp": "B", "zh": "好啊，我们在地铁站见！", "py": "hǎo a, wǒ men zài dì tiě zhàn jiàn!"}], "q": [{"q": "Como B vai para a escola?", "o": ["坐地铁", "骑自行车", "坐出租车", "坐公共汽车"], "ans": "坐地铁", "py": {"坐地铁": "zuò dì tiě", "骑自行车": "qí zì xíng chē", "坐出租车": "zuò chū zū chē", "坐公共汽车": "zuò gōng gòng qì chē"}}, {"q": "Como A vai para a escola?", "o": ["骑自行车", "坐地铁", "坐火车", "骑马"], "ans": "骑自行车", "py": {"骑自行车": "qí zì xíng chē", "坐地铁": "zuò dì tiě", "坐火车": "zuò huǒ chē", "骑马": "qí mǎ"}}, {"q": "Onde eles vão se encontrar?", "o": ["地铁站", "学校", "巴西饭店", "火车站"], "ans": "地铁站", "py": {"地铁站": "dì tiě zhàn", "学校": "xué xiào", "巴西饭店": "bā xī fàn diàn", "火车站": "huǒ chē zhàn"}}]}, {"a": 7, "t": "Que dia é hoje?", "lines": [{"sp": "A", "zh": "李同学，我听说星期天是你的生日！", "py": "lǐ tóng xué, wǒ tīng shuō xīng qī tiān shì nǐ de shēng rì!"}, {"sp": "B", "zh": "是的，五月二十四号是我的生日。", "py": "shì de, wǔ yuè èr shí sì hào shì wǒ de shēng rì."}, {"sp": "A", "zh": "太好了！我明天去商场买礼物给你。", "py": "tài hǎo le! wǒ míng tiān qù shāng chǎng mǎi lǐ wù gěi nǐ."}, {"sp": "A", "zh": "李同学！祝你生日快乐！这是我买的礼物。", "py": "lǐ tóng xué! zhù nǐ shēng rì kuài lè! zhè shì wǒ mǎi de lǐ wù."}, {"sp": "B", "zh": "谢谢你！我看一下！一双白色的鞋子！你的礼物太好了！", "py": "xiè xie nǐ! wǒ kàn yī xià! yī shuāng bái sè de xié zi! nǐ de lǐ wù tài hǎo le!"}, {"sp": "A", "zh": "你喜欢运动，我买给你一双运动鞋。", "py": "nǐ xǐ huan yùn dòng, wǒ mǎi gěi nǐ yī shuāng yùn dòng xié."}, {"sp": "B", "zh": "太谢谢你了。来来，给你一块蛋糕！", "py": "tài xiè xie nǐ le. lái lái, gěi nǐ yī kuài dàn gāo!"}], "q": [{"q": "Quando é o aniversário do colega Li?", "o": ["五月二十四号", "五月二十号", "六月十二号", "星期六"], "ans": "五月二十四号", "py": {"五月二十四号": "wǔ yuè èr shí sì hào", "五月二十号": "wǔ yuè èr shí hào", "六月十二号": "liù yuè shí èr hào", "星期六": "xīng qī liù"}}, {"q": "Que presente A comprou?", "o": ["一双运动鞋", "一件衣服", "一个手机", "一块蛋糕"], "ans": "一双运动鞋", "py": {"一双运动鞋": "yī shuāng yùn dòng xié", "一件衣服": "yī jiàn yī fu", "一个手机": "yī ge shǒu jī", "一块蛋糕": "yī kuài dàn gāo"}}, {"q": "O que B oferece para A?", "o": ["一块蛋糕", "一双鞋子", "一个礼物", "一杯水"], "ans": "一块蛋糕", "py": {"一块蛋糕": "yī kuài dàn gāo", "一双鞋子": "yī shuāng xié zi", "一个礼物": "yī ge lǐ wù", "一杯水": "yī bēi shuǐ"}}]}, {"a": 8, "t": "Amanhã é feriado!", "lines": [{"sp": "A", "zh": "你好哥哥！你知道下个星期一是节日吗？", "py": "nǐ hǎo gē ge! nǐ zhī dào xià ge xīng qī yī shì jié rì ma?"}, {"sp": "B", "zh": "你好妹妹！我知道，为什么？", "py": "nǐ hǎo mèi mei! wǒ zhī dào, wèi shén me?"}, {"sp": "A", "zh": "因为我们没有课，所以我和朋友想去北京玩儿，你有空和我们去吗？", "py": "yīn wèi wǒ men méi yǒu kè, suǒ yǐ wǒ hé péng you xiǎng qù běi jīng wánr, nǐ yǒu kòng hé wǒ men qù ma?"}, {"sp": "B", "zh": "有空！我也想去，你们什么时候去？", "py": "yǒu kòng! wǒ yě xiǎng qù, nǐ men shén me shí hòu qù?"}, {"sp": "A", "zh": "我们星期天去，可以吗？", "py": "wǒ men xīng qī tiān qù, kě yǐ ma?"}, {"sp": "B", "zh": "好的，在北京你们想去哪儿？", "py": "hǎo de, zài běi jīng nǐ men xiǎng qù nǎr?"}, {"sp": "A", "zh": "我们想去故宫和长城，怎么样？", "py": "wǒ men xiǎng qù gù gōng hé cháng chéng, zěn me yàng?"}, {"sp": "B", "zh": "太好了，我们在哪儿见？几点见？", "py": "tài hǎo le, wǒ men zài nǎr jiàn? jǐ diǎn jiàn?"}, {"sp": "A", "zh": "我们可以早上七点半在地铁站见。", "py": "wǒ men kě yǐ zǎo shang qī diǎn bàn zài dì tiě zhàn jiàn."}, {"sp": "B", "zh": "好，我们在那儿见！", "py": "hǎo, wǒ men zài nàr jiàn!"}], "q": [{"q": "O que é a próxima segunda-feira?", "o": ["节日", "生日", "考试", "星期天"], "ans": "节日", "py": {"节日": "jié rì", "生日": "shēng rì", "考试": "kǎo shì", "星期天": "xīng qī tiān"}}, {"q": "Aonde eles querem ir em Pequim?", "o": ["故宫和长城", "上海", "西安", "商场"], "ans": "故宫和长城", "py": {"故宫和长城": "gù gōng hé cháng chéng", "上海": "shàng hǎi", "西安": "xī ān", "商场": "shāng chǎng"}}, {"q": "A que horas vão se encontrar?", "o": ["早上七点半", "晚上七点", "早上八点", "中午十二点"], "ans": "早上七点半", "py": {"早上七点半": "zǎo shang qī diǎn bàn", "晚上七点": "wǎn shang qī diǎn", "早上八点": "zǎo shang bā diǎn", "中午十二点": "zhōng wǔ shí èr diǎn"}}]}, {"a": 10, "t": "Quando chegar, me ligue", "lines": [{"sp": "A", "zh": "你今天几点要去中国？我会想你！", "py": "nǐ jīn tiān jǐ diǎn yào qù zhōng guó? wǒ huì xiǎng nǐ!"}, {"sp": "B", "zh": "是的，我今天晚上八点半会去机场，明天到北京！", "py": "shì de, wǒ jīn tiān wǎn shang bā diǎn bàn huì qù jī chǎng, míng tiān dào běi jīng!"}, {"sp": "A", "zh": "你到北京机场的时候请打电话给我！", "py": "nǐ dào běi jīng jī chǎng de shí hòu qǐng dǎ diàn huà gěi wǒ!"}, {"sp": "B", "zh": "好的，我会打电话给你！", "py": "hǎo de, wǒ huì dǎ diàn huà gěi nǐ!"}], "q": [{"q": "A que horas B vai ao aeroporto?", "o": ["晚上八点半", "早上八点半", "明天", "中午"], "ans": "晚上八点半", "py": {"晚上八点半": "wǎn shang bā diǎn bàn", "早上八点半": "zǎo shang bā diǎn bàn", "明天": "míng tiān", "中午": "zhōng wǔ"}}, {"q": "Para que cidade B vai?", "o": ["北京", "上海", "西安", "巴西"], "ans": "北京", "py": {"北京": "běi jīng", "上海": "shàng hǎi", "西安": "xī ān", "巴西": "bā xī"}}, {"q": "O que B vai fazer quando chegar?", "o": ["打电话", "吃饭", "睡觉", "买礼物"], "ans": "打电话", "py": {"打电话": "dǎ diàn huà", "吃饭": "chī fàn", "睡觉": "shuì jiào", "买礼物": "mǎi lǐ wù"}}]}, {"a": 12, "t": "Alô, quem é?", "lines": [{"sp": "A", "zh": "喂，我是马丽，您是哪位？", "py": "wéi, wǒ shì mǎ lì, nín shì nǎ wèi?"}, {"sp": "B", "zh": "你好，我是雨果，你的同事，你现在有空吗？", "py": "nǐ hǎo, wǒ shì yǔ guǒ, nǐ de tóng shì, nǐ xiàn zài yǒu kòng ma?"}, {"sp": "A", "zh": "有空，今天我没去上班，为什么？", "py": "yǒu kòng, jīn tiān wǒ méi qù shàng bān, wèi shén me?"}, {"sp": "B", "zh": "我想请你吃饭。", "py": "wǒ xiǎng qǐng nǐ chī fàn."}, {"sp": "A", "zh": "哇，好的！我们会去哪儿？几点见？在哪儿见？", "py": "wa, hǎo de! wǒ men huì qù nǎr? jǐ diǎn jiàn? zài nǎr jiàn?"}, {"sp": "B", "zh": "我听说我们城市的巴西饭店太好了，我们可以十一点在火车站见！", "py": "wǒ tīng shuō wǒ men chéng shì de bā xī fàn diàn tài hǎo le, wǒ men kě yǐ shí yī diǎn zài huǒ chē zhàn jiàn!"}, {"sp": "A", "zh": "太好了，我们一会儿见啊！", "py": "tài hǎo le, wǒ men yī huìr jiàn a!"}], "q": [{"q": "Quem fez a ligação?", "o": ["雨果", "马丽", "王先生", "老板"], "ans": "雨果", "py": {"雨果": "yǔ guǒ", "马丽": "mǎ lì", "王先生": "wáng xiān sheng", "老板": "lǎo bǎn"}}, {"q": "Por que ele ligou?", "o": ["想请马丽吃饭", "想去上班", "想买东西", "想看电影"], "ans": "想请马丽吃饭", "py": {"想请马丽吃饭": "xiǎng qǐng mǎ lì chī fàn", "想去上班": "xiǎng qù shàng bān", "想买东西": "xiǎng mǎi dōng xi", "想看电影": "xiǎng kàn diàn yǐng"}}, {"q": "Onde e quando vão se encontrar?", "o": ["十一点在火车站", "十一点在饭店", "十二点在地铁站", "晚上在家"], "ans": "十一点在火车站", "py": {"十一点在火车站": "shí yī diǎn zài huǒ chē zhàn", "十一点在饭店": "shí yī diǎn zài fàn diàn", "十二点在地铁站": "shí èr diǎn zài dì tiě zhàn", "晚上在家": "wǎn shang zài jiā"}}]}]}