{"lessons": [{"n": 1, "t": "Onde você mora?"}, {"n": 2, "t": "Posso ir comer com você?"}, {"n": 3, "t": "Como você vai à escola?"}, {"n": 4, "t": "Nós podemos nos divertir!"}, {"n": 5, "t": "Faz mais barato, chefe!"}, {"n": 6, "t": "Que horas são?"}, {"n": 7, "t": "Que dia é hoje?"}, {"n": 8, "t": "Amanhã é feriado!"}, {"n": 9, "t": "Você já comeu?"}, {"n": 10, "t": "O que tem em cima?"}, {"n": 11, "t": "Como está o tempo?"}, {"n": 12, "t": "Alô, quem é?"}, {"n": 13, "t": "Extra HSK 2"}], "theory": {"1": [{"s": "住在 + Lugar", "u": "morar em", "zh": "我住在巴西。", "py": "wǒ zhù zài bā xī.", "pt": "Eu moro no Brasil."}, {"s": "在 + Verbo (+ 呢)", "u": "ação em andamento", "zh": "那个小姐在喝水。", "py": "nà ge xiǎo jiě zài hē shuǐ.", "pt": "Aquela moça está bebendo água."}, {"s": "在 + Lugar", "u": "estar em algum lugar", "zh": "我们都在北京。", "py": "wǒ men dōu zài běi jīng.", "pt": "Estamos todos em Pequim."}, {"s": "会 + Verbo", "u": "saber fazer (habilidade aprendida)", "zh": "医生不会说汉语。", "py": "yī shēng bù huì shuō hàn yǔ.", "pt": "O médico não sabe falar chinês."}, {"s": "知道 + informação", "u": "saber que / conhecer algo", "zh": "我不知道你说什么。", "py": "wǒ bù zhī dào nǐ shuō shén me.", "pt": "Não sei o que você diz."}, {"s": "知道怎么 + Verbo", "u": "saber como fazer", "zh": "爸爸知道怎么开车。", "py": "bà ba zhī dào zěn me kāi chē.", "pt": "Papai sabe dirigir."}, {"s": "能 × 可以", "u": "能 = capaz/permitido; 可以 = só permitido", "zh": "我不能吃肉。", "py": "wǒ bù néng chī ròu.", "pt": "Não posso comer carne (por um impedimento)."}, {"s": "好 + verbo", "u": "cria adjetivos", "zh": "这个菜很好吃。", "py": "zhè ge cài hěn hǎo chī.", "pt": "Este prato é gostoso."}, {"s": "太…了 / 不太", "u": "demais / não muito", "zh": "那个杯子太贵了。", "py": "nà ge bēi zi tài guì le.", "pt": "Aquela xícara é cara demais."}], "2": [{"s": "Sujeito + 在 + Lugar + Verbo", "u": "fazer algo em um lugar", "zh": "我在那个公司工作。", "py": "wǒ zài nà ge gōng sī gōng zuò.", "pt": "Trabalho naquela empresa."}, {"s": "去 + Lugar", "u": "ir para", "zh": "我想去银行。", "py": "wǒ xiǎng qù yín háng.", "pt": "Quero ir ao banco."}, {"s": "回 + Lugar", "u": "voltar para", "zh": "姐姐想要回家。", "py": "jiě jie xiǎng yào huí jiā.", "pt": "A irmã quer voltar para casa."}, {"s": "回来 × 回去", "u": "voltar para cá × para lá", "zh": "你回来吧！", "py": "nǐ huí lái ba!", "pt": "Volte para cá!"}, {"s": "A + 和 + B", "u": "\"e\" entre substantivos", "zh": "西瓜和苹果都是水果。", "py": "xī guā hé píng guǒ dōu shì shuǐ guǒ.", "pt": "Melancia e maçã são frutas."}, {"s": "A + 和 + B + 一起 + Verbo", "u": "fazer junto com", "zh": "我想和你一起回中国。", "py": "wǒ xiǎng hé nǐ yī qǐ huí zhōng guó.", "pt": "Quero voltar à China junto com você."}], "3": [{"s": "怎么 + Verbo", "u": "como (de que forma)", "zh": "你怎么去学校？", "py": "nǐ zěn me qù xué xiào?", "pt": "Como você vai para a escola?"}, {"s": "Sujeito + 怎么样？", "u": "como está?", "zh": "你怎么样？", "py": "nǐ zěn me yàng?", "pt": "Como você está?"}, {"s": "坐 + transporte + 去", "u": "ir de (sentado, tipo poltrona)", "zh": "我坐公共汽车去学校。", "py": "wǒ zuò gōng gòng qì chē qù xué xiào.", "pt": "Vou de ônibus para a escola."}, {"s": "骑 + transporte", "u": "ir montado (perna de cada lado)", "zh": "我骑自行车去公司。", "py": "wǒ qí zì xíng chē qù gōng sī.", "pt": "Vou de bicicleta para a empresa."}], "4": [{"s": "买 (mǎi) × 卖 (mài)", "u": "comprar × vender", "zh": "我想去商店买东西。", "py": "wǒ xiǎng qù shāng diàn mǎi dōng xi.", "pt": "Quero ir à loja comprar coisas."}, {"s": "玩 + objeto", "u": "brincar/jogar com", "zh": "弟弟想玩游戏。", "py": "dì di xiǎng wán yóu xì.", "pt": "O irmão mais novo quer jogar videogame."}, {"s": "Lugar + 玩", "u": "ir se divertir em", "zh": "我想去北京玩。", "py": "wǒ xiǎng qù běi jīng wán.", "pt": "Quero ir me divertir em Pequim."}, {"s": "在 + Lugar + 见", "u": "nos vemos em", "zh": "我们在饭店见！", "py": "wǒ men zài fàn diàn jiàn!", "pt": "Nos vemos no restaurante!"}, {"s": "Tempo + 见", "u": "nos vemos (quando)", "zh": "我们一会儿见！", "py": "wǒ men yī huìr jiàn!", "pt": "Nos vemos daqui a pouco!"}], "5": [{"s": "一 + 张 + objeto plano", "u": "classificador de coisas planas", "zh": "我有三张票。", "py": "wǒ yǒu sān zhāng piào.", "pt": "Tenho três bilhetes."}, {"s": "贵 × 便宜", "u": "caro × barato", "zh": "太贵了！便宜点，老板！", "py": "tài guì le! pián yi diǎn, lǎo bǎn!", "pt": "Caro demais! Faz mais barato, chefe!"}, {"s": "Verbo + 一点儿 + objeto", "u": "um pouco (quantidade)", "zh": "我想喝一点水。", "py": "wǒ xiǎng hē yī diǎn shuǐ.", "pt": "Quero beber um pouco de água."}, {"s": "Adjetivo + 一点儿", "u": "um pouco mais (comparação)", "zh": "这个好一点。", "py": "zhè ge hǎo yī diǎn.", "pt": "Este é um pouco melhor."}, {"s": "Verbo + 一下", "u": "um instante (tempo curto)", "zh": "你看一下。", "py": "nǐ kàn yī xià.", "pt": "Dê uma olhadinha."}, {"s": "一共 + valor", "u": "no total", "zh": "一共八十五块钱。", "py": "yī gòng bā shí wǔ kuài qián.", "pt": "No total, 85 yuans."}], "6": [{"s": "Descrição + 的 + coisa", "u": "o adjetivo vem antes", "zh": "我想买白色的T恤。", "py": "wǒ xiǎng mǎi bái sè de T xù.", "pt": "Quero comprar uma camiseta branca."}, {"s": "需要 + verbo", "u": "precisar", "zh": "我需要买一些东西。", "py": "wǒ xū yào mǎi yī xiē dōng xi.", "pt": "Preciso comprar algumas coisas."}, {"s": "上 × 下 + substantivo", "u": "começar/entrar × sair", "zh": "我晚上七点下班。", "py": "wǒ wǎn shang qī diǎn xià bān.", "pt": "Saio do trabalho às 7 da noite."}, {"s": "Nº + 点 + Nº + 分", "u": "horas e minutos", "zh": "现在一点五分。", "py": "xiàn zài yī diǎn wǔ fēn.", "pt": "Agora é 1h05."}, {"s": "…点半", "u": "e meia", "zh": "现在两点半。", "py": "xiàn zài liǎng diǎn bàn.", "pt": "Agora são duas e meia."}, {"s": "Período + hora + ação", "u": "quando acontece", "zh": "我早上八点上课。", "py": "wǒ zǎo shang bā diǎn shàng kè.", "pt": "Tenho aula às 8 da manhã."}], "7": [{"s": "Tempo + Sujeito + Verbo", "u": "ordem com palavra de tempo", "zh": "明天我去饭店吃饭。", "py": "míng tiān wǒ qù fàn diàn chī fàn.", "pt": "Amanhã vou comer no restaurante."}, {"s": "星期 + nº", "u": "dia da semana", "zh": "今天是星期三。", "py": "jīn tiān shì xīng qī sān.", "pt": "Hoje é quarta-feira."}, {"s": "年 + 月 + 日/号", "u": "data: ano → mês → dia", "zh": "我的生日是六月十二号。", "py": "wǒ de shēng rì shì liù yuè shí èr hào.", "pt": "Meu aniversário é 12 de junho."}, {"s": "听说 + frase", "u": "ouvi dizer que", "zh": "我听说今天是你的生日。", "py": "wǒ tīng shuō jīn tiān shì nǐ de shēng rì.", "pt": "Ouvi dizer que hoje é seu aniversário."}, {"s": "买礼物给 + pessoa", "u": "comprar presente para", "zh": "我去商场买礼物给你。", "py": "wǒ qù shāng chǎng mǎi lǐ wù gěi nǐ.", "pt": "Vou ao shopping comprar um presente para você."}], "8": [{"s": "今年 / 明年 / 去年", "u": "este ano / próximo / passado", "zh": "我去年回巴西。", "py": "wǒ qù nián huí bā xī.", "pt": "Ano passado voltei ao Brasil."}, {"s": "上个 × 下个 + mês/semana", "u": "passado × próximo", "zh": "下个星期我们没有课。", "py": "xià ge xīng qī wǒ men méi yǒu kè.", "pt": "Semana que vem não temos aula."}, {"s": "每 + (个) + substantivo", "u": "cada / todo", "zh": "我每天早上七点起床。", "py": "wǒ měi tiān zǎo shang qī diǎn qǐ chuáng.", "pt": "Levanto às 7 todo dia."}, {"s": "为什么 + frase？", "u": "por quê?", "zh": "为什么你今天很忙？", "py": "wèi shén me nǐ jīn tiān hěn máng?", "pt": "Por que você está ocupado hoje?"}, {"s": "什么时候 + frase？", "u": "quando?", "zh": "你什么时候有空？", "py": "nǐ shén me shí hòu yǒu kòng?", "pt": "Quando você tem tempo livre?"}, {"s": "因为…，所以…", "u": "porque…, por isso…", "zh": "因为明天是节日，所以我们不上课。", "py": "yīn wèi míng tiān shì jié rì, suǒ yǐ wǒ men bù shàng kè.", "pt": "Como amanhã é feriado, não teremos aula."}], "9": [{"s": "开始 + verbo", "u": "começar a fazer", "zh": "她上个星期开始学汉语。", "py": "tā shàng ge xīng qī kāi shǐ xué hàn yǔ.", "pt": "Ela começou a estudar chinês semana passada."}, {"s": "Adjetivo + 了", "u": "mudança de estado", "zh": "我弟弟饿了。", "py": "wǒ dì di è le.", "pt": "Meu irmão ficou com fome."}, {"s": "Verbo + 了 + objeto", "u": "ação concluída", "zh": "我买了一个手机。", "py": "wǒ mǎi le yī ge shǒu jī.", "pt": "Comprei um celular."}, {"s": "V + objeto + tempo + 了", "u": "ação que dura até hoje", "zh": "我学习汉语一年了。", "py": "wǒ xué xí hàn yǔ yī nián le.", "pt": "Estudo chinês há um ano."}, {"s": "没(有) + verbo", "u": "negar o passado (sem 了)", "zh": "我没买手机。", "py": "wǒ méi mǎi shǒu jī.", "pt": "Não comprei o celular."}, {"s": "不…了", "u": "não… mais", "zh": "这个果汁我不喝了。", "py": "zhè ge guǒ zhī wǒ bù hē le.", "pt": "Não bebo mais este suco."}, {"s": "会 + verbo", "u": "futuro", "zh": "今天妈妈会做饭。", "py": "jīn tiān mā ma huì zuò fàn.", "pt": "Hoje a mamãe vai cozinhar."}, {"s": "要 + verbo", "u": "futuro próximo / intenção", "zh": "我要去北京。", "py": "wǒ yào qù běi jīng.", "pt": "Vou a Pequim."}, {"s": "(请)不要 + verbo", "u": "imperativo negativo", "zh": "请你不要走！", "py": "qǐng nǐ bù yào zǒu!", "pt": "Por favor, não vá embora!"}], "10": [{"s": "看见 / 听见", "u": "ver / ouvir (resultado)", "zh": "我没看见你。", "py": "wǒ méi kàn jiàn nǐ.", "pt": "Não te vi."}, {"s": "Verbo + 不 + 见", "u": "não conseguir ver/ouvir", "zh": "我看不见。", "py": "wǒ kàn bù jiàn.", "pt": "Não consigo ver."}, {"s": "Frase + 的时候", "u": "quando (afirmação)", "zh": "你到的时候给我打电话。", "py": "nǐ dào de shí hòu gěi wǒ dǎ diàn huà.", "pt": "Quando chegar, me ligue."}, {"s": "给 + pessoa + 打电话", "u": "telefonar para", "zh": "请给我打电话。", "py": "qǐng gěi wǒ dǎ diàn huà.", "pt": "Por favor, me ligue."}, {"s": "A + 在 + objeto + posição", "u": "A está em cima/dentro/…", "zh": "猫在桌子上。", "py": "māo zài zhuō zi shàng.", "pt": "O gato está em cima da mesa."}, {"s": "Lugar + 有 + coisa", "u": "existe algo em um lugar", "zh": "桌子上有一本书。", "py": "zhuō zi shàng yǒu yī běn shū.", "pt": "Tem um livro em cima da mesa."}, {"s": "Posição + 面", "u": "parte de cima/de trás…", "zh": "医院在学校前面。", "py": "yī yuàn zài xué xiào qián mian.", "pt": "O hospital fica em frente à escola."}], "11": [{"s": "厕所在哪儿？", "u": "onde fica o banheiro?", "zh": "厕所在商店前面。", "py": "cè suǒ zài shāng diàn qián mian.", "pt": "O banheiro fica em frente à loja."}, {"s": "远 × 近", "u": "longe × perto", "zh": "我的家很远。", "py": "wǒ de jiā hěn yuǎn.", "pt": "Minha casa é longe."}, {"s": "Lugar1 + 离 + Lugar2 + adjetivo", "u": "distância entre lugares", "zh": "我家离公司很近。", "py": "wǒ jiā lí gōng sī hěn jìn.", "pt": "Minha casa é perto da empresa."}, {"s": "天气怎么样？", "u": "como está o tempo?", "zh": "今天天气很冷。", "py": "jīn tiān tiān qì hěn lěng.", "pt": "Hoje está frio."}, {"s": "下雨 / 下雪", "u": "chover / nevar", "zh": "明天会下雨吗？", "py": "míng tiān huì xià yǔ ma?", "pt": "Vai chover amanhã?"}, {"s": "Frase + 了", "u": "situação nova, \"agora\"", "zh": "下雨了！", "py": "xià yǔ le!", "pt": "Começou a chover!"}], "12": [{"s": "喂，是哪位？", "u": "alô, quem fala?", "zh": "喂，王先生在吗？", "py": "wéi, wáng xiān sheng zài ma?", "pt": "Alô, o senhor Wang está?"}, {"s": "S1 + 请 + S2 + ação", "u": "convidar", "zh": "我想请你看电影。", "py": "wǒ xiǎng qǐng nǐ kàn diàn yǐng.", "pt": "Quero te convidar para ver um filme."}, {"s": "不好意思", "u": "desculpa (leve)", "zh": "不好意思，我没看见你。", "py": "bù hǎo yì si, wǒ méi kàn jiàn nǐ.", "pt": "Desculpa, não te vi."}, {"s": "帮助 / 帮 + pessoa", "u": "ajudar", "zh": "你可以帮我吗？", "py": "nǐ kě yǐ bāng wǒ ma?", "pt": "Você pode me ajudar?"}, {"s": "Nº + 百", "u": "centenas", "zh": "这个电脑九百五十块钱。", "py": "zhè ge diàn nǎo jiǔ bǎi wǔ shí kuài qián.", "pt": "Este computador custa 950 yuans."}, {"s": "(是) + detalhe + verbo + 的", "u": "enfatiza quando/onde/como no passado", "zh": "我是坐地铁去大学的。", "py": "wǒ shì zuò dì tiě qù dà xué de.", "pt": "Foi de metrô que fui à faculdade."}], "13": [{"s": "Verbo + 过", "u": "experiência (já fiz alguma vez)", "zh": "我去过中国。", "py": "wǒ qù guo zhōng guó.", "pt": "Já fui à China."}, {"s": "A + 比 + B + adjetivo", "u": "A é mais… que B", "zh": "我比你高。", "py": "wǒ bǐ nǐ gāo.", "pt": "Sou mais alto que você."}, {"s": "A + 没有 + B + adjetivo", "u": "A não é tão… quanto B", "zh": "我没有你高。", "py": "wǒ méi yǒu nǐ gāo.", "pt": "Não sou tão alto quanto você."}, {"s": "Verbo + 得 + adjetivo", "u": "modo/grau da ação", "zh": "他跑得很快。", "py": "tā pǎo de hěn kuài.", "pt": "Ele corre rápido."}, {"s": "最 + adjetivo", "u": "superlativo", "zh": "这个最便宜。", "py": "zhè ge zuì pián yi.", "pt": "Este é o mais barato."}, {"s": "已经 + verbo + 了", "u": "já (concluído)", "zh": "我已经吃饭了。", "py": "wǒ yǐ jīng chī fàn le.", "pt": "Já comi."}, {"s": "快要 + verbo + 了", "u": "está prestes a", "zh": "快要下雨了。", "py": "kuài yào xià yǔ le.", "pt": "Está para chover."}, {"s": "Verbo + 着", "u": "estado que continua", "zh": "门开着。", "py": "mén kāi zhe.", "pt": "A porta está aberta."}, {"s": "A 还是 B？", "u": "ou (em pergunta)", "zh": "你喝茶还是咖啡？", "py": "nǐ hē chá hái shì kā fēi?", "pt": "Você bebe chá ou café?"}, {"s": "Verbo + nº + 次", "u": "quantas vezes", "zh": "我去过两次。", "py": "wǒ qù guo liǎng cì.", "pt": "Já fui duas vezes."}]}, "notes": {"1": "会 é saber nadar; 知道 é saber onde fica a piscina.", "2": "和 só liga substantivos. Nunca use 和 para ligar frases.", "3": "Dá para cruzar as pernas no veículo? Então é 坐. Perna de cada lado? 骑.", "4": "卖 é 买 com um \"chapéu\" (十): quem vende tem algo a mais para oferecer.", "5": "一点儿 mede em gramas (quantidade); 一下 mede em segundos (tempo).", "6": "Diga 两点, nunca 二点, para 2 horas.", "7": "天 é dia como período; 日/号 é dia como data.", "8": "\"Ano passado\" é 去年. Ano não leva 个.", "9": "了 é um carimbo de \"mudou\". Passado negativo nunca leva 了: 我没吃, nunca 我没吃了.", "10": "看 é apontar a câmera; 看见 é a foto sair.", "11": "了 no fim da frase marca uma situação nova: 下雨了 = começou a chover.", "12": "Na negativa, 是 é obrigatório: 不是…的.", "13": "了 diz \"aconteceu\"; 过 diz \"já está no álbum de experiências\"."}, "vocab": [{"a": 1, "zh": "城市", "py": "chéng shì", "pt": "cidade"}, {"a": 1, "zh": "北京", "py": "běi jīng", "pt": "Pequim"}, {"a": 1, "zh": "上海", "py": "shàng hǎi", "pt": "Xangai"}, {"a": 1, "zh": "西安", "py": "xī ān", "pt": "Xi'an"}, {"a": 1, "zh": "住", "py": "zhù", "pt": "morar"}, {"a": 1, "zh": "在", "py": "zài", "pt": "estar em / estar fazendo"}, {"a": 1, "zh": "可以", "py": "kě yǐ", "pt": "poder (permissão)"}, {"a": 1, "zh": "能", "py": "néng", "pt": "poder (ser capaz)"}, {"a": 1, "zh": "知道", "py": "zhī dào", "pt": "saber (informação)"}, {"a": 1, "zh": "会", "py": "huì", "pt": "saber fazer"}, {"a": 1, "zh": "哪儿", "py": "nǎr", "pt": "onde"}, {"a": 1, "zh": "故宫", "py": "gù gōng", "pt": "Cid